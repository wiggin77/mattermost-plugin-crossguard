<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cross Guard XML wire-format schema. Authoritative wire contract for
  compliance content inspection: every byte that crosses a security
  domain boundary must validate against this file. The plugin's wire
  types in server/wire/ are the producer and must remain conformant.

  Every string element carries a pattern and/or maxLength; every
  container has a concrete maxOccurs upper bound.

  Constraint conventions:
    * 26-character Mattermost IDs use MattermostIdType ([a-z0-9]{26}).
    * Channel/team/conn names use SlugType (lowercase alnum + - _, max 64).
    * Usernames use UsernameType (lowercase alnum + - _ ., max 64).
      Colon-bearing remote-tagged usernames are not on the wire; the
      producer resolves them via Props.RemoteUsername or truncates at
      the colon before serializing (see server/wire/user.go).
    * Emails use EmailType (RFC-style pattern, max 254).
    * Locale codes use LocaleType (BCP 47-shaped, max 35).
    * Free-form short text (Nickname, FirstName, Position, etc.) uses
      bounded maxLength only, no pattern, since Mattermost permits Unicode.
    * Post bodies use MessageTextType (max 1048576, 1 MiB).
    * Status uses an enumeration of the four documented presence values.
    * maxOccurs upper bounds derived from product limits (FileIds=10)
      or generous per-envelope batch caps (User/Reaction/Status/etc.=1000,
      Transform=1000, StringMap Entry=100).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified">

  <!-- ============================================================
       Constrained simple types
       ============================================================ -->

  <!-- 26-character Mattermost ID (mmModel.NewId) -->
  <xs:simpleType name="MattermostIdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9]{26}"/>
      <xs:maxLength value="26"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Channel/team slug or connection name: lowercase alnum, hyphens, underscores -->
  <xs:simpleType name="SlugType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9][a-z0-9_\-]{0,63}"/>
      <xs:maxLength value="64"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Mattermost username: lowercase alnum, hyphens, underscores, periods -->
  <xs:simpleType name="UsernameType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9][a-z0-9_\-\.]{0,63}"/>
      <xs:maxLength value="64"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Display name for webhook overrides: looser than UsernameType, still bounded -->
  <xs:simpleType name="DisplayNameType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="128"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- RFC 5321 capped email length (254) with a permissive local-part pattern -->
  <xs:simpleType name="EmailType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}"/>
      <xs:maxLength value="254"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- BCP 47-shaped locale code, e.g. en, en-US, zh-Hant-TW -->
  <xs:simpleType name="LocaleType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}"/>
      <xs:maxLength value="35"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Space-separated Mattermost role names (system_user, system_admin, etc.) -->
  <xs:simpleType name="RolesType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9_ ]{0,1024}"/>
      <xs:maxLength value="1024"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Emoji name: alnum, underscore, hyphen, plus -->
  <xs:simpleType name="EmojiNameType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9_\-\+]{1,64}"/>
      <xs:maxLength value="64"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- URL bounded to 2048 (browser-safe limit) -->
  <xs:simpleType name="UrlType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="2048"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Short free-form text (Nickname, FirstName, LastName, etc.) -->
  <xs:simpleType name="ShortTextType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="128"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Medium free-form text (Position, BotDescription, CustomStatus) -->
  <xs:simpleType name="MediumTextType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="1024"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Hashtags string: space-separated #tags -->
  <xs:simpleType name="HashtagsType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="1024"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Post body text, capped at 1 MiB -->
  <xs:simpleType name="MessageTextType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="1048576"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Post.Type: typically empty or a "system_*" marker string -->
  <xs:simpleType name="PostTypeStringType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="64"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Presence status: documented values from Mattermost model -->
  <xs:simpleType name="StatusEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="online"/>
      <xs:enumeration value="away"/>
      <xs:enumeration value="dnd"/>
      <xs:enumeration value="offline"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- StringMap entry attribute key/value (Timezone keys, etc.) -->
  <xs:simpleType name="MapKeyType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="128"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MapValueType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="4096"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- MentionTransforms key/value: source mention vs. transformed mention -->
  <xs:simpleType name="MentionKeyType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="256"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MentionValueType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="256"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================
       Envelope-level types
       ============================================================ -->

  <xs:simpleType name="EnvelopeTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sync_msg"/>
      <xs:enumeration value="test"/>
      <xs:enumeration value="attachment"/>
      <xs:enumeration value="profile_image"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TimestampType">
    <xs:restriction base="xs:dateTime"/>
  </xs:simpleType>

  <!--
    EpochIdType: 26-character Mattermost ID identifying the sender
    process generation. Generated via mmModel.NewId() at OnActivate
    and emitted on every sender-originated envelope (sync_msg and
    test) so the receiver can detect sender restart. Same format as
    every other ID on the wire.
  -->
  <xs:simpleType name="EpochIdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9]{26}"/>
      <xs:maxLength value="26"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="CrossGuardEnvelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ConnName"    type="SlugType"/>
        <xs:element name="Timestamp"   type="TimestampType"/>
        <xs:element name="Epoch"       type="EpochIdType"   minOccurs="0"/>
        <xs:element name="Sequence"    type="xs:unsignedLong" minOccurs="0"/>
        <xs:element name="TeamName"    type="SlugType"/>
        <xs:element name="ChannelName" type="SlugType"/>
        <xs:choice minOccurs="0">
          <xs:element name="SyncMsg" type="SyncMsgType"/>
          <xs:element name="TestID"  type="MattermostIdType"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="version" type="xs:int"           use="required"/>
      <xs:attribute name="type"    type="EnvelopeTypeEnum" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ============================================================
       SyncMsg payload
       ============================================================ -->

  <xs:complexType name="SyncMsgType">
    <xs:sequence>
      <xs:element name="Id"                type="MattermostIdType"/>
      <xs:element name="ChannelId"         type="MattermostIdType"/>
      <xs:element name="Users"             type="UsersType"             minOccurs="0"/>
      <xs:element name="Post"              type="PostType"              minOccurs="0"/>
      <xs:element name="Reactions"         type="ReactionsContainerType"         minOccurs="0"/>
      <xs:element name="Statuses"          type="StatusesContainerType"          minOccurs="0"/>
      <xs:element name="MembershipChanges" type="MembershipChangesContainerType" minOccurs="0"/>
      <xs:element name="Acknowledgements"  type="AcknowledgementsContainerType"  minOccurs="0"/>
      <xs:element name="MentionTransforms" type="MentionTransformsType"          minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="UsersType">
    <xs:sequence>
      <xs:element name="User" minOccurs="0" maxOccurs="1000">
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="UserType">
              <xs:attribute name="id" type="MattermostIdType" use="required"/>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReactionsContainerType">
    <xs:sequence>
      <xs:element name="Reaction" type="ReactionType" minOccurs="0" maxOccurs="1000"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="StatusesContainerType">
    <xs:sequence>
      <xs:element name="Status" type="StatusType" minOccurs="0" maxOccurs="1000"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MembershipChangesContainerType">
    <xs:sequence>
      <xs:element name="MembershipChange" type="MembershipChangeType" minOccurs="0" maxOccurs="1000"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AcknowledgementsContainerType">
    <xs:sequence>
      <xs:element name="PostAcknowledgement" type="PostAcknowledgementType" minOccurs="0" maxOccurs="1000"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MentionTransformsType">
    <xs:sequence>
      <xs:element name="Transform" minOccurs="0" maxOccurs="1000">
        <xs:complexType>
          <xs:attribute name="key"   type="MentionKeyType"   use="required"/>
          <xs:attribute name="value" type="MentionValueType" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ============================================================
       Content types
       ============================================================ -->

  <!--
    Post: the wire-pruned subset of mmModel.Post.

    Dropped (do not cross): MessageSource, PendingPostId, ReplyCount,
    LastReplyAt, Participants, IsFollowing, Filenames, Metadata, plus
    PostProps keys not in PostPropsType (attachments, previewed_post,
    force_notification, channel_mentions, current_team_id,
    unsafe_links, expire_at, read_duration, shared_channel_state,
    workspace_name).
  -->
  <xs:complexType name="PostType">
    <xs:sequence>
      <xs:element name="Id"           type="MattermostIdType"/>
      <xs:element name="CreateAt"     type="xs:long"/>
      <xs:element name="UpdateAt"     type="xs:long"/>
      <xs:element name="EditAt"       type="xs:long"   minOccurs="0"/>
      <xs:element name="DeleteAt"     type="xs:long"/>
      <xs:element name="UserId"       type="MattermostIdType"/>
      <xs:element name="ChannelId"    type="MattermostIdType"/>
      <xs:element name="RootId"       type="MattermostIdType" minOccurs="0"/>
      <xs:element name="OriginalId"   type="MattermostIdType" minOccurs="0"/>
      <xs:element name="Message"      type="MessageTextType"/>
      <xs:element name="Type"         type="PostTypeStringType" minOccurs="0"/>
      <xs:element name="Props"        type="PostPropsType" minOccurs="0"/>
      <xs:element name="Hashtags"     type="HashtagsType" minOccurs="0"/>
      <xs:element name="FileIds"      type="FileIdsType" minOccurs="0"/>
      <xs:element name="HasReactions" type="xs:boolean" minOccurs="0"/>
      <xs:element name="RemoteId"     type="MattermostIdType"  minOccurs="0"/>
      <xs:element name="IsPinned"     type="xs:boolean" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FileIdsType">
    <xs:sequence>
      <xs:element name="Id" type="MattermostIdType" minOccurs="0" maxOccurs="10"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    PostProps: typed, whitelisted subset of upstream Post.Props
    (StringInterface). Only the keys listed cross the wire.
  -->
  <xs:complexType name="PostPropsType">
    <xs:sequence>
      <xs:element name="FromWebhook"              type="xs:boolean" minOccurs="0"/>
      <xs:element name="FromBot"                  type="xs:boolean" minOccurs="0"/>
      <xs:element name="FromPlugin"               type="xs:boolean" minOccurs="0"/>
      <xs:element name="FromOAuthApp"             type="xs:boolean" minOccurs="0"/>
      <xs:element name="OverrideUsername"         type="DisplayNameType" minOccurs="0"/>
      <xs:element name="OverrideIconURL"          type="UrlType"         minOccurs="0"/>
      <xs:element name="OverrideIconEmoji"        type="EmojiNameType"   minOccurs="0"/>
      <xs:element name="WebhookDisplayName"       type="DisplayNameType" minOccurs="0"/>
      <xs:element name="AddedUserId"              type="MattermostIdType" minOccurs="0"/>
      <xs:element name="DeleteBy"                 type="MattermostIdType" minOccurs="0"/>
      <xs:element name="AddChannelMember"         type="MattermostIdType" minOccurs="0"/>
      <xs:element name="MentionHighlightDisabled" type="xs:boolean" minOccurs="0"/>
      <xs:element name="DisableGroupHighlight"    type="xs:boolean" minOccurs="0"/>
      <xs:element name="AIGeneratedByUserId"      type="MattermostIdType" minOccurs="0"/>
      <xs:element name="AIGeneratedByUsername"    type="UsernameType"     minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    User: the wire-pruned subset of mmModel.User.

    Dropped (do not cross): AuthService, EmailVerified, AllowMarketing,
    NotifyProps, LastPasswordUpdate, LastPictureUpdate, FailedAttempts,
    MfaActive, LastActivityAt, TermsOfServiceId, TermsOfServiceCreateAt,
    DisableWelcomeEmail, LastLogin, plus credential material already
    suppressed upstream (Password, AuthData, MfaSecret, MfaUsedTimestamps).

    User.Props keys are restricted to UserPropsType.
  -->
  <xs:complexType name="UserType">
    <xs:sequence>
      <xs:element name="Id"                type="MattermostIdType"/>
      <xs:element name="CreateAt"          type="xs:long"   minOccurs="0"/>
      <xs:element name="UpdateAt"          type="xs:long"   minOccurs="0"/>
      <xs:element name="DeleteAt"          type="xs:long"/>
      <xs:element name="Username"          type="UsernameType"/>
      <xs:element name="Email"             type="EmailType"/>
      <xs:element name="Nickname"          type="ShortTextType" minOccurs="0"/>
      <xs:element name="FirstName"         type="ShortTextType" minOccurs="0"/>
      <xs:element name="LastName"          type="ShortTextType" minOccurs="0"/>
      <xs:element name="Position"          type="MediumTextType" minOccurs="0"/>
      <xs:element name="Roles"             type="RolesType"/>
      <xs:element name="Locale"            type="LocaleType" minOccurs="0"/>
      <xs:element name="Timezone"          type="StringMapType" minOccurs="0"/>
      <xs:element name="Props"             type="UserPropsType" minOccurs="0"/>
      <xs:element name="RemoteId"          type="MattermostIdType" minOccurs="0"/>
      <xs:element name="IsBot"             type="xs:boolean" minOccurs="0"/>
      <xs:element name="BotDescription"    type="MediumTextType" minOccurs="0"/>
      <xs:element name="BotLastIconUpdate" type="xs:long"    minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    UserProps: typed, whitelisted subset of upstream User.Props
    (StringMap). Only the keys listed cross the wire.
  -->
  <xs:complexType name="UserPropsType">
    <xs:sequence>
      <xs:element name="CustomStatus"     type="MediumTextType"   minOccurs="0"/>
      <xs:element name="RemoteUsername"   type="UsernameType"     minOccurs="0"/>
      <xs:element name="RemoteEmail"      type="EmailType"        minOccurs="0"/>
      <xs:element name="OriginalRemoteId" type="MattermostIdType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    StringMapType: an open string-to-string map serialized as a
    sequence of <Entry key="..." value="..."/> elements, sorted by
    key. Used for User.Timezone where the key set is not fixed by
    the schema (e.g., "automaticTimezone", "manualTimezone",
    "useAutomaticTimezone").
  -->
  <xs:complexType name="StringMapType">
    <xs:sequence>
      <xs:element name="Entry" minOccurs="0" maxOccurs="100">
        <xs:complexType>
          <xs:attribute name="key"   type="MapKeyType"   use="required"/>
          <xs:attribute name="value" type="MapValueType" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReactionType">
    <xs:sequence>
      <xs:element name="UserId"    type="MattermostIdType"/>
      <xs:element name="PostId"    type="MattermostIdType"/>
      <xs:element name="EmojiName" type="EmojiNameType"/>
      <xs:element name="CreateAt"  type="xs:long"/>
      <xs:element name="UpdateAt"  type="xs:long"/>
      <xs:element name="DeleteAt"  type="xs:long"/>
      <xs:element name="RemoteId"  type="MattermostIdType" minOccurs="0"/>
      <xs:element name="ChannelId" type="MattermostIdType"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    Status: presence-status snapshot.

    Dropped (do not cross): ActiveChannel (channel ID is local to the
    source server).
  -->
  <xs:complexType name="StatusType">
    <xs:sequence>
      <xs:element name="UserId"         type="MattermostIdType"/>
      <xs:element name="Status"         type="StatusEnum"/>
      <xs:element name="Manual"         type="xs:boolean"/>
      <xs:element name="LastActivityAt" type="xs:long"/>
      <xs:element name="DNDEndTime"     type="xs:long"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MembershipChangeType">
    <xs:sequence>
      <xs:element name="ChannelId"  type="MattermostIdType"/>
      <xs:element name="UserId"     type="MattermostIdType"/>
      <xs:element name="IsAdd"      type="xs:boolean"/>
      <xs:element name="RemoteId"   type="MattermostIdType" minOccurs="0"/>
      <xs:element name="ChangeTime" type="xs:long"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PostAcknowledgementType">
    <xs:sequence>
      <xs:element name="UserId"         type="MattermostIdType"/>
      <xs:element name="PostId"         type="MattermostIdType"/>
      <xs:element name="AcknowledgedAt" type="xs:long"/>
      <xs:element name="ChannelId"      type="MattermostIdType"/>
      <xs:element name="RemoteId"       type="MattermostIdType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
